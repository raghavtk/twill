%YAML 1.2
---
name: JSON with Comments
file_extensions: [jsonc]
scope: source.jsonc
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.jsonc
    - match: '/\*'
      scope: punctuation.definition.comment.begin.jsonc
      push: block-comment
    - match: '"'
      scope: punctuation.definition.string.begin.jsonc
      push: string
    - match: '\b(true|false|null)\b'
      scope: constant.language.jsonc
    - match: '-?\b[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?'
      scope: constant.numeric.jsonc
    - match: '[{}\[\],:]'
      scope: punctuation.separator.jsonc
  block-comment:
    - meta_scope: comment.block.jsonc
    - match: '\*/'
      pop: true
  string:
    - meta_scope: string.quoted.double.jsonc
    - match: '\\.'
      scope: constant.character.escape.jsonc
    - match: '"'
      pop: true
